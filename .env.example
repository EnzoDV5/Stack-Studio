# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser —
# never put secrets here. All reads go through src/lib/config.ts.

# Where the Start a project brief is POSTed as JSON (e.g. a Formspree endpoint:
# https://formspree.io/f/xxxxxxx). Optional fallback. Development can use a local stub;
# production requires at least one delivery channel.
VITE_FORM_ENDPOINT=

# Firebase web app config from Project settings > General > Your apps.
# These values are public client identifiers, not admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check > reCAPTCHA v3 site key. Leave empty until App Check is set up.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# EmailJS dashboard values. The Contact Us template can handle both normal enquiries
# and project briefs. Link one auto-reply to it in the EmailJS dashboard.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_BRIEF_TEMPLATE_ID=
# Keep false on EmailJS Free. For paid plans, add a Variable Attachment named brief_pdf.
VITE_EMAILJS_ATTACH_PDF=false

# Plausible-style analytics site ID (your domain, e.g. stackstudio.co.za).
# Leave empty to disable analytics completely — no script is loaded.
VITE_ANALYTICS_ID=
